<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<!-- System-provided UI (file panels, text field menus) follows the user's language, like the
	     settings window does (UIText). -->
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleExecutable</key>
	<string>AllInOneIME</string>
	<!-- Bundle and input source IDs keep the original name: macOS keys the enabled input source,
	     the microphone permission and the settings by them. -->
	<key>CFBundleIdentifier</key>
	<string>com.aipinyin.inputmethod.AIPinyin</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AllInOneIME</string>
	<key>CFBundleDisplayName</key>
	<string>AllInOneIME</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Personal build</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>按住右 ⌥ 说话时录音。语音在这台 Mac 上识别成文字，不会上传。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>按住右 ⌥ 说话时把语音识别成文字（在这台 Mac 上完成）。</string>
	<key>InputMethodConnectionName</key>
	<string>com.aipinyin.inputmethod.AIPinyin_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>AllInOneIMEInputController</string>
	<key>TISInputSourceID</key>
	<string>com.aipinyin.inputmethod.AIPinyin</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<key>TISIconIsTemplate</key>
	<true/>
	<!-- Hans only, like Apple's pinyin: adding Latn makes the source ASCII-capable, and
	     ASCII-capable sources stay active in password fields. -->
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
	</array>
	<key>tsInputMethodIconFileKey</key>
	<string>icon.tiff</string>
</dict>
</plist>
