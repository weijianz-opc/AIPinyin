<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice input (hold the right Option key). With the hardened runtime, microphone access
	     needs this entitlement in addition to the user's permission. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- @claude and "run in Terminal" commands: Terminal is asked (Apple events) to open a window and
	     run the command once its shell is ready. @imessage: Messages is asked to send a confirmed message. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- @imessage: finds recipients in Contacts (names, phone numbers, emails; asked the first time
	     @imessage is typed). -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
</dict>
</plist>
