<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice input (hold the right Option key). With the hardened runtime, microphone access
	     needs this entitlement in addition to the user's permission. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Apple events, which the hardened runtime blocks without this (the user is still asked, under
	     Automation): @claude and "run in Terminal" commands ask Terminal to open a window and run the
	     command once its shell is ready; @note saves to Notes through AppleScript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- @reminder uses EventKit for Reminders. This is the hardened runtime's EventKit entitlement
	     (named for Calendar); whether Reminders needs it isn't verified, so it is kept. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
