<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Voice input (hold the right Option key). With the hardened runtime, microphone access
	     needs this entitlement in addition to the user's permission. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
